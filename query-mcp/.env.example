MCP_PORT=8502

# Optional static Bearer token (useful for curl / MCP Inspector / admin access).
# Leave empty in production to force the OAuth flow.
# Generate: openssl rand -hex 32
MCP_API_KEY=

# REQUIRED for OAuth — signs the JWT access tokens issued by /oauth/token.
# Generate: openssl rand -hex 32
MCP_JWT_SIGNING_KEY=

# Public-facing base URL (used as JWT issuer and in OAuth metadata documents).
PUBLIC_URL=https://ap-dashboard.dev.standtogether.org

# Connection strings — use localhost since docker-compose uses host networking
# ap_review: port 5432 (already exposed by ap_review_dashboard docker-compose)
AP_DASHBOARD_DB_URL=postgresql://ap_user:<ap_password>@localhost:5432/ap_review
# pcard: port 5433 (exposed by pcard-app docker-compose)
# Get the real credentials from /data/p-card-dashboard/.env on the EC2
PCARD_DB_URL=postgresql://pcard:<pcard_password>@localhost:5433/pcard
# aging_report: port is whatever DB_HOST_PORT is set to on the aging-report
# compose (default 5434 locally; may differ on the EC2).
# Get the real credentials from /data/aging-report/.env on the EC2
AGING_REPORT_DB_URL=postgresql://aging:<aging_password>@localhost:5434/aging
